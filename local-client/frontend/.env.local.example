# Frontend environment. Copy to .env.local.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time — they
# are visible to anyone loading the page, and changing one needs a dev-server
# restart, not just a refresh. Never put a secret here.

# Which backend the browser calls. Either local-backend or remote-server; they
# expose the same /api surface.
#   http://127.0.0.1:8000   local-backend on this machine (default)
#   http://<lan-ip>:8000    a teammate's machine on the same network
#   https://x.ngrok-free.dev  a tunnel
#   /                       same origin as the page — what -Ngrok sets, so one
#                           tunnel serves both and there is no CORS to configure
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Where thumbnails get decoded.
#   server (default) — the backend runs one ffmpeg process per thumbnail. Fine
#                      for one viewer; a shared grid is up to 100 decodes per
#                      person, all queued on the host.
#   client           — the backend returns a byte range and the browser decodes
#                      it with WebCodecs, so decode cost scales with viewers
#                      instead of stacking on one machine. Falls back to the
#                      server route silently when WebCodecs is missing, the
#                      codec is unsupported, or a frame fails — a slow-path
#                      thumbnail looks identical.
# Only local-backend serves the two routes this needs (/api/zip-frame-plan and
# /api/zip-bytes); against remote-server it degrades to server mode.
NEXT_PUBLIC_FRAME_DECODE=server

# URL of the local backend (FastAPI).
# Copy this file to .env.local and adjust if you change the port.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Where thumbnails get decoded.
#   server (default) — backend runs ffmpeg per thumbnail, as before
#   client           — backend returns a byte range, the browser decodes with
#                      WebCodecs. Decode cost then scales with viewers instead
#                      of stacking on one machine. Falls back to server
#                      automatically when WebCodecs is missing or a frame fails.
NEXT_PUBLIC_FRAME_DECODE=server

# ENV_MODE controls where the DataProvider fetches data from.
#
#   MOCK   — reads from app/mock/*.json  (default, works without any server)
#   SAMPLE — reads ../../AIC2026_sample keyframes/metadata directly
#   LOCAL — proxies requests to the GPU server via Ngrok/LAN
#
ENV_MODE=MOCK

# For text-only PECore-bigG14-448
# CACHED_MODEL = ../../challenge_resources/pe_text_tower

# Only needed if AIC2026_sample is not inside or beside the repository:
# AIC_SAMPLE_ROOT=D:\path\to\AIC2026_sample

# Optional PE-Core text encoder settings for SAMPLE mode:
# PECORE_DEVICE=cpu
# PECORE_DEVICE=mps      # Apple silicon MacBook GPU
# PECORE_PRECISION=fp32

# Optional (SAMPLE mode): query embedded Milvus Lite for raw.semantic instead
# of linear numpy search over local .npy files (pip install -r
# requirements-milvus-lite.txt). Falls back to linear search when unset or
# the collection doesn't exist. Same file remote-server's ingest scripts
# write to when pointed at the same path.
# MILVUS_LITE_PATH=D:\path\to\challenge_resources\data\milvus_lite.db

# Load the PE-Core text encoder at backend startup instead of on the first
# query — avoids a multi-second model-load hit on whoever searches first.
# WARMUP_TEXT_ENCODER=true

# Vietnamese-to-English translation uses Google Translate's free web
# endpoint (app/services/translation.py) — no config needed.

# Only needed when ENV_MODE=LOCAL:
# REMOTE_SERVER_URL=https://your-ngrok-url.ngrok.io

# Origins allowed to call this local backend (your Next.js dev server)
CORS_ORIGINS=http://localhost:3000

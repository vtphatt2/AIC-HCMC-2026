# ENV_MODE controls where the DataProvider fetches data from.
#
#   MOCK  — reads from app/mock/*.json  (default, works without any server)
#   LOCAL — proxies requests to the GPU server via Ngrok/LAN
#
ENV_MODE=MOCK

# Only needed when ENV_MODE=LOCAL:
# REMOTE_SERVER_URL=https://your-ngrok-url.ngrok.io

# Origins allowed to call this local backend (your Next.js dev server)
CORS_ORIGINS=http://localhost:3000

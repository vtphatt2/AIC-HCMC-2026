# local-backend environment.
#
# Every variable this backend reads is listed, with its default and its accepted
# values. Commented-out lines are the default — uncomment only to change it.
# Booleans accept 1 / true / yes (case-insensitive); anything else is false.
#
# This file wins over the shell: main.py calls load_dotenv(override=True), so a
# value set here beats one exported by a launch script.

# ── Mode ──────────────────────────────────────────────────────────────────────
# ZIP   - search the vectors exported from challenge_resources/data/zip_file,
#         the only dataset this backend has. Serves its own frames/video from
#         the organizers' archives over HTTP Range.
# LOCAL - do no searching; proxy every raw-data request to REMOTE_SERVER_URL.
#         Adds the two channels the archives do not carry (subtitled.semantic,
#         transcript.semantic).
# Anything else fails at startup.
ENV_MODE=ZIP

# Required when ENV_MODE=LOCAL, ignored otherwise. Trailing slash is stripped.
# REMOTE_SERVER_URL=https://your-ngrok-url.ngrok.io

# Origins allowed to call this backend. Comma-separated, no spaces. Private LAN
# addresses (localhost, 10.x, 192.168.x, 172.16-31.x) are always allowed on top
# of this, on any port, so a phone on the same Wi-Fi works without editing it.
# Default (http://localhost:3000) comes from the repo-root .env — only set
# this when the port or origin actually differs, e.g. a non-default frontend
# port. See ../../.env.example.
# CORS_ORIGINS=http://localhost:3000

# ── Data location ─────────────────────────────────────────────────────────────
# Root of challenge_resources/data. Auto-detected inside or beside the repo;
# set it when the data lives elsewhere.
# AIC_SAMPLE_ROOT=D:\path\to\AIC-HCMC-2026\challenge_resources\data

# Path to the Milvus Lite database file. Its *directory* is what matters most:
# vectors.f32.npy and vectors.meta.npz are read from there, and that is what
# search actually uses. Unset means no vectors are found and the backend
# refuses to start.
#   Build them:  python scripts/export_vectors_npy.py   (after every ingest)
# MILVUS_LITE_PATH=D:\path\to\challenge_resources\data\milvus_lite.db

# Where the ingest archives (*_results.zip) live, used to recover a video's fps
# when video_fps.json is missing. Default: <data>/zip_file
# RESULTS_ZIP_DIR=D:\path\to\challenge_resources\data\zip_file

# Precomputed video_id -> fps, written by remote-server/scripts/export_video_fps.py.
# Default: <RESULTS_ZIP_DIR>/../video_fps.json. Without it the backend scans the
# archives, then falls back to the MP4's own moov - which is wrong for the 91
# videos that are not 25 fps. See docs/zip_media.md.
# VIDEO_FPS_MAP=D:\path\to\challenge_resources\data\video_fps.json

# ── Vector search ─────────────────────────────────────────────────────────────
# Rows scanned per block in the exact numpy path. Barely affects speed
# (34/35/37 ms at 16k/64k/193k rows); it bounds peak memory so the same code
# holds when the corpus outgrows RAM.
# NUMPY_SEARCH_CHUNK_ROWS=65536

# Only consulted on the Milvus Lite fallback (i.e. when vectors.f32.npy is
# absent). Accepted: milvus | hnsw | flat | scann | cagra.
#   flat  - exact, correct, the only safe choice here
#   hnsw  - milvus_lite 3.2.0 returns wrong neighbours and scores under 1% of
#           the collection. See docs/milvus-lite-hnsw-recall-bug.md.
#   cagra - remote-server only; unavailable here
VECTOR_SEARCH_BACKEND=flat

# Milvus Lite collection names, all on the fallback path only. Defaults shown.
# MILVUS_COLLECTION=video_frames
# MILVUS_COLLECTION_HNSW=video_frames
# MILVUS_COLLECTION_FLAT=video_frames_flat
# MILVUS_COLLECTION_SCANN=video_frames_scann
# MILVUS_SUBTITLED_COLLECTION=video_frames_subtitled
# MILVUS_TRANSCRIPT_COLLECTION=transcript_chunks
# VECTOR_DIM=1280            # PE-Core-bigG-14-448 output width
# TRANSCRIPT_VECTOR_DIM=384  # multilingual-e5-small output width
# MILVUS_HOST / MILVUS_PORT are read but unused here - this backend never talks
# to a Milvus server, only to the embedded file above.

# ── Text encoder ──────────────────────────────────────────────────────────────
# torch - full OpenCLIP text tower. GPU-capable. Requires CACHED_MODEL (below)
#         and requirements-torch.txt.
# onnx  - quantized INT8 text-encoder-only graph, ~515 MB, CPU only, no weight
#         download. Default in requirements.txt.
# PECORE_BACKEND=onnx

# Required by PECORE_BACKEND=torch: a directory holding config.json,
# model.safetensors and bpe_simple_vocab_16e6.txt.gz for the text-only tower.
# CACHED_MODEL=../../challenge_resources/pe_text_tower

# cpu | cuda | mps. cuda fails fast if unavailable; mps requires fp32.
# PECORE_DEVICE=cpu
# fp32 | fp16. fp16 is for CUDA; mps rejects anything but fp32.
# PECORE_PRECISION=fp32

# ONNX Runtime intra-op threads per encode. Measured on 20 cores: 105 ms at 14,
# 115 ms at 20 - past memory-bandwidth saturation more threads only contend.
# PECORE_ONNX_THREADS=14

# Overrides for the ONNX artifacts. Default: <repo>/challenge_resources/onnx-models/
# PECORE_ONNX_MODEL_PATH=.../text_model_int8.onnx
# PECORE_BPE_VOCAB_PATH=.../bpe_simple_vocab_16e6.txt.gz

# Model identity. Changing either without re-ingesting makes queries and the
# index incomparable.
# PECORE_MODEL_ID=hf-hub:timm/PE-Core-bigG-14-448
# PECORE_TEXT_DIM=1280
# PECORE_CONTEXT_LENGTH=72   # tokens; longer queries are truncated

# Load the encoder at startup instead of on the first query - moves a
# multi-second model load off whoever searches first.
# WARMUP_TEXT_ENCODER=true

# ── Frames and playback (docs/zip_media.md) ───────────────────────────────────
# Read from the organizers' video ZIPs over HTTP Range. Requires
# challenge_resources/data/zip_video_index.json, built once with
# scripts/build_zip_video_index.py; without it every frame 404s and the UI
# falls back to YouTube.

# In-flight requests on /api/zip-frame. Mostly network wait.
# ZIP_FRAME_CONCURRENCY=12
# Concurrent ffmpeg processes. CPU-bound - keep it well below the above, or
# per-video moov downloads queue behind decodes and a cold grid gets slower.
# ZIP_FRAME_DECODE_CONCURRENCY=6
# GOP byte cache. Thumbnails cluster into the same videos and often the same
# GOP, so this turns most of a grid into zero network.
# ZIP_REGION_CACHE_MB=192
# On-disk moov cache (~1 MB per video, never changes).
# ZIP_MOOV_CACHE_DIR=<repo>/cache/zip_moov

# ── Optional: structured query parser ─────────────────────────────────────────
# Only strategies that call context.parse_json() use this. Unset = no parser,
# and those strategies fail; every other strategy is unaffected.
# GEMINI_API_KEY=
# GEMINI_QUERY_MODEL=gemini-3.1-flash-lite

# Vietnamese-to-English translation uses Google Translate's free web endpoint
# (app/services/translation.py) - no key, nothing to configure.

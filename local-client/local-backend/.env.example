# ENV_MODE controls where the DataProvider gets its data.
#
#   ZIP   — searches the vectors exported from challenge_resources/data/zip_file,
#           the only dataset this backend has. Default.
#   LOCAL — proxies raw-data requests to the GPU server via Ngrok/LAN
#
ENV_MODE=ZIP

# For text-only PECore-bigG14-448
# CACHED_MODEL = ../../challenge_resources/pe_text_tower

# Where the data lives. Needed unless challenge_resources/ sits beside the repo.
# AIC_SAMPLE_ROOT=D:\path\to\AIC-HCMC-2026\challenge_resources\data

# Required in ZIP mode: vectors.f32.npy and vectors.meta.npz sit next to this
# file, and search reads those, not Milvus. Build them with
# `python scripts/export_vectors_npy.py` after every ingest. Milvus Lite is only
# the fallback for a machine that has not run it (pip install -r
# requirements-milvus-lite.txt), and must stay on the FLAT index — see
# docs/milvus-lite-hnsw-recall-bug.md.
# MILVUS_LITE_PATH=D:\path\to\challenge_resources\data\milvus_lite.db
VECTOR_SEARCH_BACKEND=flat

# Optional PE-Core text encoder settings:
# PECORE_BACKEND=onnx    # or torch (needs requirements-torch.txt)
# PECORE_DEVICE=cpu      # or mps on Apple silicon
# PECORE_PRECISION=fp32
# PECORE_ONNX_THREADS=14

# Load the PE-Core text encoder at backend startup instead of on the first
# query — avoids a multi-second model-load hit on whoever searches first.
# WARMUP_TEXT_ENCODER=true

# Thumbnails and playback come from the organizers' video ZIPs over HTTP Range.
# Build the offset index once with scripts/build_zip_video_index.py; these only
# tune it. See docs/zip_media.md.
# ZIP_FRAME_CONCURRENCY=12
# ZIP_FRAME_DECODE_CONCURRENCY=6
# ZIP_REGION_CACHE_MB=192

# Vietnamese-to-English translation uses Google Translate's free web
# endpoint (app/services/translation.py) — no config needed.

# Only needed when ENV_MODE=LOCAL:
# REMOTE_SERVER_URL=https://your-ngrok-url.ngrok.io

# Origins allowed to call this local backend (your Next.js dev server)
CORS_ORIGINS=http://localhost:3000

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_summary", "primary", "fallback"],
  "properties": {
    "plan_summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "primary": {"$ref": "#/$defs/attempt"},
    "fallback": {
      "anyOf": [
        {"$ref": "#/$defs/attempt"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "strategy", "events"],
      "properties": {
        "mode": {"type": "string", "enum": ["frames", "transcript"]},
        "strategy": {"type": "string", "minLength": 1},
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/event"}
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "transcript", "min_offset_ms"],
      "properties": {
        "visual": {"type": "string"},
        "transcript": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "min_offset_ms": {"type": "integer", "minimum": 0, "maximum": 120000}
      }
    }
  }
}

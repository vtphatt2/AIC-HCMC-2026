# Fireworks.ai — Qwen3.7 Plus (OpenAI-compatible vision)
# Get your key: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/qwen3p7-plus

# Ngrok tunnel for sharing the local app (scripts/start-local.ps1 -Ngrok).
# The authtoken also lives in ngrok's own config (~/AppData/Local/ngrok/ngrok.yml).
NGROK_DOMAIN=your-domain.ngrok-free.dev
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Backend tuning (see docs/performance_pain_points.md for the measurements).
# Per-backend settings live in local-client/local-backend/.env.example and
# remote-server/.env.example; these are the shared tuning knobs.
PECORE_ONNX_THREADS=14

# Thumbnail/playback out of the organizers' video ZIPs (docs/zip_media.md).
# ZIP_REGION_CACHE_MB and ZIP_FRAME_CONCURRENCY apply to local-backend only —
# it fetches over HTTP Range; remote-server seeks in a local file and caches
# nothing. ZIP_FRAME_DECODE_CONCURRENCY caps ffmpeg on both.
ZIP_REGION_CACHE_MB=192
ZIP_FRAME_CONCURRENCY=12
ZIP_FRAME_DECODE_CONCURRENCY=6

# Rows scanned per block in the numpy exact-search path. Barely affects speed
# (34/35/37 ms at 16k/64k/193k); it bounds peak memory so the same code holds
# when the corpus outgrows RAM.
NUMPY_SEARCH_CHUNK_ROWS=65536

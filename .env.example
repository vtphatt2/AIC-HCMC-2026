# Repo-root environment: launch scripts and standalone tools only.
#
# The backends do NOT read this file — they read their own:
#   local-client/local-backend/.env.example   (56-var reference for ZIP/LOCAL mode)
#   remote-server/.env.example                (reference for SERVER mode)
#   local-client/frontend/.env.local.example  (browser-visible settings)
#
# Booleans accept 1 / true / yes; anything else is false.

# ── Ngrok sharing (scripts/start-local.ps1 -Ngrok) ────────────────────────────
# The domain is read out of this file by the launch script, or passed as
# -NgrokDomain. The authtoken lives in ngrok's own config
# (~/AppData/Local/ngrok/ngrok.yml) — nothing here reads NGROK_AUTHTOKEN, it is
# kept only as a note of where the value belongs.
NGROK_DOMAIN=your-domain.ngrok-free.dev
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Ports (launch scripts + scripts/share-proxy.cjs) ──────────────────────────
# share-proxy splits one public port: /api/* and /static/* to the backend,
# /api/tuning-draft and everything else to Next.
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# SHARE_PORT=3001

# ── Shared backend tuning ─────────────────────────────────────────────────────
# Both backends read these, but each also accepts them in its own .env, which
# takes precedence (load_dotenv(override=True) runs per backend). Measurements
# behind the numbers: docs/performance_pain_points.md.

# ONNX Runtime intra-op threads per text encode. 105 ms at 14 on 20 cores,
# 115 ms at 20 — past memory-bandwidth saturation more threads only contend.
PECORE_ONNX_THREADS=14

# Thumbnails/playback out of the organizers' video ZIPs (docs/zip_media.md).
# ZIP_REGION_CACHE_MB and ZIP_FRAME_CONCURRENCY are local-backend only — it
# fetches over HTTP Range, where caching and in-flight limits matter.
# remote-server seeks in a local file and caches nothing.
# ZIP_FRAME_DECODE_CONCURRENCY caps ffmpeg on both.
ZIP_REGION_CACHE_MB=192
ZIP_FRAME_CONCURRENCY=12
ZIP_FRAME_DECODE_CONCURRENCY=6

# Rows scanned per block in the numpy exact-search path (local-backend). Barely
# affects speed (34/35/37 ms at 16k/64k/193k); it bounds peak memory so the
# same code holds when the corpus outgrows RAM.
NUMPY_SEARCH_CHUNK_ROWS=65536

# ── scripts/synthetic_query_generator only ────────────────────────────────────
# OpenAI-compatible vision endpoint used to generate synthetic queries. Not
# read by either backend. Get a key: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/qwen3p7-plus

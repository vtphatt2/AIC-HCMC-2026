# Fireworks.ai — Qwen3.7 Plus (OpenAI-compatible vision)
# Get your key: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/qwen3p7-plus

# Ngrok tunnel for sharing the local app (scripts/start-local.ps1 -Ngrok).
# The authtoken also lives in ngrok's own config (~/AppData/Local/ngrok/ngrok.yml).
NGROK_DOMAIN=your-domain.ngrok-free.dev
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local backend tuning (see docs/performance_pain_points.md for the measurements)
PECORE_ONNX_THREADS=14
ZIP_REGION_CACHE_MB=192
ZIP_FRAME_CONCURRENCY=12
ZIP_FRAME_DECODE_CONCURRENCY=6

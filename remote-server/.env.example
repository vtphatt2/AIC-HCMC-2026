# remote-server environment.
#
# Every variable this server reads is listed, with its default and its accepted
# values. Commented-out lines are the default — uncomment only to change it.
# Booleans accept 1 / true / yes (case-insensitive); anything else is false.
# main.py calls load_dotenv(override=True), so this file beats the shell.

# ── Mode ──────────────────────────────────────────────────────────────────────
# SERVER is the only accepted value; the DataProvider refuses to start otherwise.
ENV_MODE=SERVER

# Origins allowed to call this server. Comma-separated, no spaces. Private LAN
# addresses are always allowed on top of this, on any port.
# Default (http://localhost:3000) comes from the repo-root .env — only set
# this when sharing over ngrok or a different frontend origin needs to be
# added. See ../.env.example and docs/SETUP.md § 5.
# CORS_ORIGINS=http://localhost:3000,https://your-domain.ngrok-free.dev

# Preset writes are shared state. Keep false on anything a teammate can reach —
# the tuning UI sends per-request config_overrides instead, which need no flag.
ALLOW_STRATEGY_CONFIG_WRITES=false

# ── Milvus ────────────────────────────────────────────────────────────────────
# Set MILVUS_LITE_PATH to use the embedded, file-backed Milvus instead of a
# server: no Docker, no MILVUS_HOST/PORT. Dev/test only — production is a real
# Milvus server. Needs pymilvus>=2.4 (requirements-milvus-lite.txt); the base
# requirements.txt pins 2.3.7 for the server path.
# MILVUS_LITE_PATH=../challenge_resources/data/milvus_lite.db

MILVUS_HOST=localhost
MILVUS_PORT=19530

# One collection per index profile, so the runtime algorithm switch is real.
MILVUS_COLLECTION=video_frames
MILVUS_COLLECTION_HNSW=video_frames
MILVUS_COLLECTION_FLAT=video_frames_flat
MILVUS_COLLECTION_SCANN=video_frames_scann
# Second visual channel. Per-algorithm overrides also exist:
# MILVUS_SUBTITLED_COLLECTION_HNSW / _FLAT / _SCANN
# MILVUS_SUBTITLED_COLLECTION=video_frames_subtitled
VECTOR_DIM=1280

# Which index answers a search when the request does not name one.
# Accepted: milvus | hnsw | flat | scann | cagra
#   milvus/hnsw - HNSW ANN, COSINE
#   flat        - exact CPU search, COSINE
#   scann       - approximate, with raw-vector reordering
#   cagra       - cuVS GPU index; raw.semantic only, needs the artifacts below
VECTOR_SEARCH_BACKEND=milvus

# ── CAGRA (optional, NVIDIA GPU) ──────────────────────────────────────────────
# Built by scripts/build_cagra_index.py. Relative paths resolve under
# remote-server/. Rebuild after a cuVS upgrade — the serialized format is
# experimental.
# CAGRA_INDEX_PATH=cache/cagra/index.bin
# CAGRA_FRAME_IDS_PATH=cache/cagra/frame_ids.txt
# CAGRA_SEARCH_WIDTH=32     # itopk width; higher = better recall, slower

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# asyncpg connection string. For local dev without Docker: `scoop install
# postgresql`, initdb a data dir, then scripts/start-local-postgres.sh
# start|stop|status (port 15432, no admin rights or service needed).
POSTGRES_URL=postgresql://aic2026:aic2026@localhost:15432/aic2026

# ── Text encoder ──────────────────────────────────────────────────────────────
# torch - full OpenCLIP text tower, GPU-capable, needs CACHED_MODEL and
#         requirements-torch.txt
# onnx  - quantized INT8 text-encoder-only graph, CPU only, no weight download
# PECORE_BACKEND=onnx

# Required by PECORE_BACKEND=torch: directory with config.json,
# model.safetensors, bpe_simple_vocab_16e6.txt.gz.
# CACHED_MODEL=../challenge_resources/pe_text_tower

# cpu | cuda | mps. For CAGRA use cuda + fp16 + WARMUP_TEXT_ENCODER=true.
# On Apple silicon use VECTOR_SEARCH_BACKEND=milvus, mps, and fp32 (mps
# rejects anything else).
PECORE_DEVICE=cpu
PECORE_PRECISION=fp32

# Overrides for the ONNX artifacts. Default: <repo>/challenge_resources/onnx-models/
# PECORE_ONNX_MODEL_PATH=.../text_model_int8.onnx
# PECORE_BPE_VOCAB_PATH=.../bpe_simple_vocab_16e6.txt.gz

# Model identity. Changing either without re-ingesting makes queries and the
# index incomparable.
# PECORE_MODEL_ID=hf-hub:timm/PE-Core-bigG-14-448
# PECORE_TEXT_DIM=1280
# PECORE_CONTEXT_LENGTH=72   # tokens; longer queries are truncated

# Pay the model load at startup rather than on the first query.
WARMUP_TEXT_ENCODER=false
# Initialize the Google Translate client at startup (no model to download).
WARMUP_TRANSLATION=false

# ── Frames and playback (docs/ARCHITECTURE.md § Media) ────────────────────────
# Served by seeking inside local copies of the organizers' video archives.
# Drop Videos_L*.zip in raw_zip/ — nothing to build; /api/health reports
# local_zip_videos. Lots whose archive is absent 404 and fall back to YouTube.
# RAW_ZIP_DIR=../challenge_resources/data/raw_zip

# Precomputed video_id -> fps (scripts/export_video_fps.py). Without it the
# archives are scanned, then the MP4's own moov is used — which is wrong for
# the 91 videos that are not 25 fps.
# VIDEO_FPS_MAP=../challenge_resources/data/video_fps.json
# RESULTS_ZIP_DIR=../challenge_resources/data/zip_file

# Concurrent ffmpeg processes; the only CPU-bound part (reading bytes is a
# local seek, so there is no request-level cap here).
# ZIP_FRAME_DECODE_CONCURRENCY=6
# Wall-clock bound on one frame request, queue wait included.
# ZIP_FRAME_TIMEOUT_SEC=45

# Directory served at /static/frames. Lot archives ship no JPGs, so this is
# normally an empty directory and thumbnails come from /api/zip-frame. Set it
# only for lots that do have keyframe images on disk. Must exist if set.
# FRAME_STATIC_DIR=/path/to/keyframes

# ── Transcript chunk search (docs/archive/search_by_transcript.md) ────────────
TRANSCRIPT_CHUNK_SEARCH_ENABLED=true
# TRANSCRIPT_MODEL_ID=intfloat/multilingual-e5-small
# TRANSCRIPT_MODEL_DEVICE=cpu          # cpu | cuda
# TRANSCRIPT_VECTOR_DIM=384            # must match the model above
# MILVUS_TRANSCRIPT_COLLECTION=transcript_chunks
# WARMUP_TRANSCRIPT_SEARCH=true        # load the sentence-transformer at startup
# How far from a chunk's midpoint to look for a representative frame, and how
# many candidate frames to consider.
# TRANSCRIPT_NEAREST_FRAME_WINDOW_MS=3000
# TRANSCRIPT_NEAREST_FRAME_QUERY_LIMIT=256

# ── Optional: structured query parser ─────────────────────────────────────────
# Only strategies that call context.parse_json() use this.
# GEMINI_API_KEY=
# GEMINI_QUERY_MODEL=gemini-3.1-flash-lite

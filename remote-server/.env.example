ENV_MODE=SERVER

# Milvus connection
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=video_frames
VECTOR_DIM=1280

# Vector search: milvus (HNSW) or cagra
VECTOR_SEARCH_BACKEND=milvus

# Text encoder device: cpu, cuda, or mps. For CAGRA, use cuda, fp16, and warmup=true.
# For Apple silicon MacBook MPS, use VECTOR_SEARCH_BACKEND=milvus, PECORE_DEVICE=mps, PECORE_PRECISION=fp32.
PECORE_DEVICE=cpu
PECORE_PRECISION=fp32
WARMUP_TEXT_ENCODER=false

# Optional Vietnamese-to-English translation
TRANSLATION_PROVIDER=nmt
WARMUP_TRANSLATION=false
GOOGLE_CLOUD_PROJECT=

# Only needed when TRANSLATION_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite

# PostgreSQL connection
POSTGRES_URL=postgresql://aic2026:aic2026@localhost:15432/aic2026

# CORS — comma-separated origins allowed to call this server
CORS_ORIGINS=http://localhost:3000

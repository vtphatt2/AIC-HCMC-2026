ENV_MODE=SERVER

# Milvus connection
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=video_frames
MILVUS_COLLECTION_HNSW=video_frames
MILVUS_COLLECTION_FLAT=video_frames_flat
MILVUS_COLLECTION_SCANN=video_frames_scann
VECTOR_DIM=1280

# Vector search: milvus/hnsw, flat, or cagra
VECTOR_SEARCH_BACKEND=milvus

# Optional: directory served at /static/frames. Defaults to AIC2026_sample/keyframes when available.
# FRAME_STATIC_DIR=/path/to/AIC2026_sample/keyframes

# Text encoder device: cpu, cuda, or mps. For CAGRA, use cuda, fp16, and warmup=true.
# For Apple silicon MacBook MPS, use VECTOR_SEARCH_BACKEND=milvus, PECORE_DEVICE=mps, PECORE_PRECISION=fp32.
# PECORE_BACKEND for switching between onnx and torch, onnx for quantized models.
PECORE_DEVICE=cpu
PECORE_PRECISION=fp32
# PECORE_BACKEND=onnx
WARMUP_TEXT_ENCODER=false

# Optional Vietnamese-to-English translation
TRANSLATION_PROVIDER=nmt
WARMUP_TRANSLATION=false
GOOGLE_CLOUD_PROJECT=

# Only needed when TRANSLATION_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite

# PostgreSQL connection
POSTGRES_URL=postgresql://aic2026:aic2026@localhost:15432/aic2026

# CORS — comma-separated origins allowed to call this server
CORS_ORIGINS=http://localhost:3000

# ── Transcript chunk vector search ────────────────────────────────────────────
# Enable/disable the topic-based transcript chunk search pipeline
TRANSCRIPT_CHUNK_SEARCH_ENABLED=true

# Sentence-transformer model for chunk embeddings and topic classification
# TRANSCRIPT_MODEL_ID=intfloat/multilingual-e5-small
# TRANSCRIPT_MODEL_DEVICE=cpu

# Milvus collection name for transcript chunks (default: transcript_chunks)
# MILVUS_TRANSCRIPT_COLLECTION=transcript_chunks
# TRANSCRIPT_VECTOR_DIM=384
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
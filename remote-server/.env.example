ENV_MODE=SERVER

# Milvus connection
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=video_frames
VECTOR_DIM=1280
VECTOR_SEARCH_BACKEND=milvus

# Text encoder device. Keep cpu for portability; use cuda on a CUDA-capable server.
PECORE_DEVICE=cpu
PECORE_PRECISION=fp32
WARMUP_TEXT_ENCODER=false

# Optional direct cuVS CAGRA backend:
# VECTOR_SEARCH_BACKEND=cagra
# PECORE_DEVICE=cuda
# PECORE_PRECISION=fp16
# WARMUP_TEXT_ENCODER=true
# CAGRA_INDEX_PATH=cache/cagra/index.bin
# CAGRA_FRAME_IDS_PATH=cache/cagra/frame_ids.txt
# CAGRA_SEARCH_WIDTH=32

# PostgreSQL connection
POSTGRES_URL=postgresql://aic2026:aic2026@localhost:15432/aic2026

# CORS — comma-separated origins allowed to call this server
CORS_ORIGINS=http://localhost:3000
